# Postgres
POSTGRES_USER=local_ai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=local_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://local_ai:change-me@localhost:5432/local_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# LiteLLM proxy (fronts Ollama/vLLM, OpenAI-compatible)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=change-me

# Langfuse server secrets — REQUIRED, left blank on purpose: docker
# compose refuses to start Langfuse if any of these three is empty, so an
# un-edited `cp .env.example .env` fails loudly instead of deploying with
# a known-insecure default. Generate each separately with
# `openssl rand -hex 32` (ENCRYPTION_KEY specifically needs 64 hex chars,
# which that command produces) — they secure the self-hosted instance
# itself, one time, not per-project.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# Langfuse SDK keys (not used until Phase 5 wires trace export — create
# a project in the Langfuse UI after first boot to get real values)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me

# Local workspace root bind-mounted into task run containers
WORKSPACE_ROOT=./workspaces

# API
API_HOST=127.0.0.1
API_PORT=8000
